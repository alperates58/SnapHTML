{
  "manifest_version": 3,
  "name": "SnapHTML — Web Cloner & AI Mirror",
  "version": "2.1.0",
  "description": "Web sayfalarını stilleri, fontları ve DOM durumuyla klonlar; gerçek mobil/masaüstü viewport, modal recovery ve akıllı SPA tarayıcı ile bağımsız HTML ve ZIP üretir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SnapHTML — Web Cloner & AI Mirror",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "clipboardWrite",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "preview/*",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
